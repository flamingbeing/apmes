// Cloudflare Workers config. The Worker (worker/sites.js) serves this repo's files and decides which folder each
// address may see (worker/routes.js). No data and no secrets in this file: settings the Worker needs are set in the
// Cloudflare dashboard (keep_vars keeps them across deploys).
{
  "name": "apmes",
  "main": "worker/sites.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // every request goes through the Worker first (it picks the folder by address); it does the folder-index and
    // trailing-slash handling itself, so Cloudflare's own are off
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // no preview link per branch or build, and no *.workers.dev address: only the real addresses serve the apps
  "preview_urls": false,
  "workers_dev": false,
  "keep_vars": true,
  // the live address (moved here from anawj-site's Worker in the repo split, 21 Oct 2026)
  "routes": [{ "pattern": "apmes.anawj.com", "custom_domain": true }],
  // Beta (NOTES.md, "Beta"): a second Worker, apmes-beta, deployed from the beta branch by its own Workers Builds
  // (deploy command `npx wrangler deploy --env beta`). It serves beta-apmes.anawj.com only; the apps there use the
  // test Firebase project.
  "env": {
    "beta": {
      "name": "apmes-beta",
      "routes": [{ "pattern": "beta-apmes.anawj.com", "custom_domain": true }]
    }
  }
}
